---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import { productPath } from '../../../utils/path';

const seo = resolvePageSeo('/products/nba-2k26-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-4">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
        <div class="space-y-3 text-sm leading-relaxed text-muted-foreground md:text-base">
          <p>
            NBA Cheats lists one premium NBA 2K26 build for Windows: Auto Green timing, unlock-all cosmetics,
            attribute editing, named config profiles, stream-proof overlay, and optional Cloud DMA when your hardware
            qualifies. Each module is described on the product page with conservative defaults meant for practice courts
            before park or rec.
          </p>
          <p>
            Before checkout, read the live status banner on the homepage and skim the setup guides in the blog.
            After purchase, the operator portal delivers the current loader—verify Steam and 2K Launcher builds match
            your ticket notes if you contact support.
          </p>
          <p>
            Use Buy now for secure checkout, or open View details to see the full feature checklist, compatibility
            notes, and step-by-step launch flow without leaving nbacheats.org.
          </p>
          <p>
            We do not list legacy tiers for other games—this catalog is NBA 2K26 only. Patch-day blog posts explain when
            to reload configs, how unlock-all visibility works in squad lobbies, and what to expect from Cloud DMA compared
            with the standard external loader path.
          </p>
        </div>
      </div>

      <div
        class:list={[
          'mt-10 grid gap-6',
          productPages.length === 1
            ? 'mx-auto w-full max-w-xl sm:max-w-2xl'
            : 'sm:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {productPages.map((product) => (
          <CatalogCard
            label={cardLabel(product)}
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            buyLabel="Buy now"
            viewLabel="View details"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
