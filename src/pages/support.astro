---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Support', path: '/support/' },
      ]}
    />
    <div class="mt-8 max-w-3xl space-y-3 text-sm leading-relaxed text-muted-foreground md:text-base">
      <p>
        Support for NBA 2K26 cheats on PC covers loader downloads, Auto Green and unlock-all setup, HWID resets, and
        checkout questions. We answer fastest when you include your order email, Windows version, and whether you use
        Steam or the 2K Launcher.
      </p>
      <p>
        Check the homepage status banner before every session—especially after NBA 2K26 patches. If modules show offline,
        wait for the Discord #status update instead of forcing outdated configs.
      </p>
      <p>
        Email works for account issues that need screenshots; Discord is best for live walkthroughs during install. The
        FAQ page answers common compatibility questions before you open a ticket.
      </p>
      <p>
        Refund and license rules live in the Terms page. We may ask for loader logs or short screen recordings when
        diagnosing HWID or config sync errors—never share portal passwords in public channels.
      </p>
    </div>
  </div>
  <ContactSupportSection titleId="support-page-title" showTicketTips />
</BaseLayout>
