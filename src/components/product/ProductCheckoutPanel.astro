---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const checklist = product.fullFeatures.slice(0, 14);
const moreCount = Math.max(0, product.fullFeatures.length - checklist.length);
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
  data-product-checkout
>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Get access</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          Included features
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-5">
      <ul class="max-h-72 space-y-2 overflow-y-auto pr-1 text-sm text-muted-foreground" role="list">
        {
          checklist.map((feature) => (
            <li class="flex items-start gap-2">
              <Icon name="circleCheck" size={16} class="mt-0.5 shrink-0 text-primary" />
              <span>{feature}</span>
            </li>
          ))
        }
        {
          moreCount > 0 && (
            <li class="pl-6 text-xs text-muted-foreground">+{moreCount} more on the full feature list below</li>
          )
        }
      </ul>

      <Button
        as="a"
        href={product.buyUrl}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
        data-checkout-buy
      >
        Buy now
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</aside>
